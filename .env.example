# OpenTradeLedger (交易账本) Environment Template
# Copy to data/.env (chmod 600) or configure directly via the Web Settings UI.
# All exchange API keys MUST be Read-Only (withdrawals & trading disabled).

OTL_HOST=127.0.0.1
OTL_PORT=8012
OTL_DATA_DIR=./data
OTL_DEMO_MODE=false
# Set OTL_REQUIRE_AUTH=true on NAS/LAN deployments to require setting a local login password (hides Skip button)
OTL_REQUIRE_AUTH=false

# Optional: Pre-configure read-only exchange keys (alternatively add via Settings UI)
BINANCE_API_KEY=your_readonly_binance_api_key
BINANCE_API_SECRET=your_readonly_binance_api_secret

OKX_API_KEY=your_readonly_okx_api_key
OKX_API_SECRET=your_readonly_okx_api_secret
OKX_API_PASSPHRASE=your_readonly_okx_passphrase

BYBIT_API_KEY=your_readonly_bybit_api_key
BYBIT_API_SECRET=your_readonly_bybit_api_secret

GATE_API_KEY=your_readonly_gate_api_key
GATE_API_SECRET=your_readonly_gate_api_secret

BITGET_API_KEY=your_readonly_bitget_api_key
BITGET_API_SECRET=your_readonly_bitget_api_secret
BITGET_API_PASSPHRASE=your_readonly_bitget_passphrase

MEXC_API_KEY=your_readonly_mexc_api_key
MEXC_API_SECRET=your_readonly_mexc_api_secret

EASICOIN_API_KEY=your_readonly_easicoin_api_key
EASICOIN_API_SECRET=your_readonly_easicoin_api_secret

# Optional: OpenAI-compatible LLM for AI trade & cost reviews
OTL_AI_BASE_URL=https://api.openai.com/v1
OTL_AI_API_KEY=your_openai_compatible_api_key
OTL_AI_MODEL=gpt-4o-mini

# Optional: Notification channels (Webhook / Telegram / Bark)
OTL_WEBHOOK_URL=
OTL_TELEGRAM_BOT_TOKEN=
OTL_TELEGRAM_CHAT_ID=
OTL_BARK_SERVER_URL=https://api.day.app
OTL_BARK_PUSH_KEY=

# OpenTradeLedger optional local .env seed (all credentials can also be added directly in the Web UI)
# Strictly use READ-ONLY API keys (never enable trading, margin, or withdrawal permissions).

BINANCE_API_KEY=your_readonly_binance_api_key
BINANCE_API_SECRET=your_readonly_binance_api_secret

OKX_API_KEY=your_readonly_okx_api_key
OKX_API_SECRET=your_readonly_okx_api_secret
OKX_API_PASSPHRASE=your_readonly_okx_passphrase

BYBIT_API_KEY=your_readonly_bybit_api_key
BYBIT_API_SECRET=your_readonly_bybit_api_secret

GATE_API_KEY=your_readonly_gate_api_key
GATE_API_SECRET=your_readonly_gate_api_secret

BITGET_API_KEY=your_readonly_bitget_api_key
BITGET_API_SECRET=your_readonly_bitget_api_secret
BITGET_API_PASSPHRASE=your_readonly_bitget_passphrase

MEXC_API_KEY=your_readonly_mexc_api_key
MEXC_API_SECRET=your_readonly_mexc_api_secret

# Hyperliquid: public 42-char 0x... wallet address only (NO private key needed)
HYPERLIQUID_WALLET_ADDRESS=your_public_0x_wallet_address

KUCOIN_API_KEY=your_readonly_kucoin_api_key
KUCOIN_API_SECRET=your_readonly_kucoin_api_secret
KUCOIN_API_PASSPHRASE=your_readonly_kucoin_passphrase

BINGX_API_KEY=your_readonly_bingx_api_key
BINGX_API_SECRET=your_readonly_bingx_api_secret

HTX_API_KEY=your_readonly_htx_api_key
HTX_API_SECRET=your_readonly_htx_api_secret

EASICOIN_API_KEY=your_readonly_easicoin_api_key
EASICOIN_API_SECRET=your_readonly_easicoin_api_secret
